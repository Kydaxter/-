            const reader = new FileReader();
            reader.onload = ev => {
                try {
                    const data = JSON.parse(ev.target.result);
                    if (data.engineConfig) Object.assign(engineConfig, data.engineConfig);
                    if (data.hero) {
                        Object.assign(hero, data.hero);
                        hero.hp = hero.maxHp;
