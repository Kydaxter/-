        /* ==============================================================
           3. ASSET MANAGER (КЭШ, GLTF, АНИМАЦИИ)
           ============================================================== */
        class AssetManager {
            constructor() {
                this.cache = new Map();
                this.loader = new THREE.GLTFLoader();
                this.subscribers = new Map();
            }

            analyzeModel(object3d) {
                let vertices = 0, triangles = 0, meshes = 0;
                object3d.traverse(child => {
                    if (child.isMesh && child.geometry) {
                        meshes++;
                        const geo = child.geometry;
                        if (geo.attributes && geo.attributes.position) vertices += geo.attributes.position.count;
                        if (geo.index) triangles += geo.index.count / 3;
                        else if (geo.attributes && geo.attributes.position) triangles += geo.attributes.position.count / 3;
                    }
                });
                return { vertices, triangles: Math.round(triangles), meshes };
            }

            normalize(gltfScene, targetHeight) {
                const box = new THREE.Box3().setFromObject(gltfScene);
                const size = new THREE.Vector3();
                const center = new THREE.Vector3();
                box.getSize(size);
                box.getCenter(center);
                const scale = targetHeight / (size.y || 1);
                const wrapper = new THREE.Group();
                gltfScene.scale.setScalar(scale);
                gltfScene.position.set(-center.x * scale, -box.min.y * scale, -center.z * scale);
                gltfScene.traverse(c => {
                    if (c.isMesh) { c.castShadow = true; c.receiveShadow = true; }
                });
                wrapper.add(gltfScene);
                return wrapper;
            }

            async loadModel(key, fileOrUrl, targetHeight, fileName = 'custom.glb') {
                return new Promise((resolve, reject) => {
                    let url = '';
                    let isObjectUrl = false;
                    if (typeof fileOrUrl === 'string') url = fileOrUrl;
                    else if (fileOrUrl instanceof File || fileOrUrl instanceof Blob) {
                        url = URL.createObjectURL(fileOrUrl);
                        isObjectUrl = true;
                    } else return reject(new Error('Недопустимый формат файла'));

                    this.loader.load(
                        url,
                        gltf => {
                            if (isObjectUrl) URL.revokeObjectURL(url);
                            if (this.has(key)) this.unload(key);
                            const stats = this.analyzeModel(gltf.scene);
                            const normalized = this.normalize(gltf.scene, targetHeight);
                            const animations = gltf.animations || [];
                            this.cache.set(key, {
                                template: normalized,
                                animations: animations,
                                stats: stats,
                                name: fileName,
                                targetHeight: targetHeight,
                                timestamp: Date.now()
                            });
                            this.notify(key, 'loaded', this.cache.get(key));
                            resolve(this.cache.get(key));
                        },
                        undefined,
                        err => {
                            if (isObjectUrl) URL.revokeObjectURL(url);
                            console.error(`Ошибка загрузки модели ${key}:`, err);
                            reject(err);
                        }
                    );
                });
            }

            instantiate(key) {
                const asset = this.cache.get(key);
                if (!asset || !asset.template) return null;
                let instance;
                if (typeof THREE.SkeletonUtils !== 'undefined' && THREE.SkeletonUtils.clone) {
                    instance = THREE.SkeletonUtils.clone(asset.template);
                } else {
                    instance = asset.template.clone(true);
                }
                if (asset.animations && asset.animations.length > 0) {
                    const mixer = new THREE.AnimationMixer(instance);
                    const clip = asset.animations[0];
                    const action = mixer.clipAction(clip);
                    action.play();
                    instance.userData.mixer = mixer;
                    instance.userData.hasCustomAnim = true;
                } else {
                    instance.userData.hasCustomAnim = false;
                }
                return instance;
            }

            has(key) { return this.cache.has(key); }
            getStats(key) { const asset = this.cache.get(key); return asset ? asset.stats : null; }
            unload(key) {
                const asset = this.cache.get(key);
                if (!asset) return;
                disposeObject(asset.template, true);
                this.cache.delete(key);
                this.notify(key, 'unloaded', null);
            }
            on(key, callback) {
                if (!this.subscribers.has(key)) this.subscribers.set(key, []);
                this.subscribers.get(key).push(callback);
            }
            notify(key, event, data) {
                const list = this.subscribers.get(key) || [];
                list.forEach(cb => cb(event, data));
            }
        }
