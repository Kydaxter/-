            hero.piercing = 0; 
            hero.attackCd = 0.6; 
            engineConfig.enemyHpMult = 1.5; 
            engineConfig.enemySpdMult = 1.4; 
            rebuildArena(18); 
            updateHeroHpUI(); 
            syncEngineInputs(); 
        };

        /* ==============================================================
           12. ГЛАВНЫЙ ИГРОВОЙ ЦИКЛ И СИСТЕМЫ ФИЗИКИ
           ============================================================== */
        const clock = new THREE.Clock();
        const projVec = new THREE.Vector3();
        let frameCount = 0, lastFpsUpdate = 0;

        function stepSingleFrame(dt) {
            const time = clock.getElapsedTime();
            updateSimulation(dt, time);
        }

        function updateSimulation(dt, time) {
            updateWaveSystem(dt, time);
            hero.mesh.visible = hero.iFrames > 0 && !engineConfig.godMode ? Math.floor(time * 20) % 2 === 0 : true;
            if (hero.iFrames > 0 && !engineConfig.godMode) hero.iFrames -= dt;

            // Движение героя
            let isMoving = false;
            let moveDx = 0, moveDz = 0;

            if (hero.isDashing) {
                if (time - hero.lastDash > hero.dashDuration) {
                    hero.isDashing = false;
                } else {
                    hero.x += hero.dashDir.x * (hero.speed * 3.2) * dt;
                    hero.z += hero.dashDir.z * (hero.speed * 3.2) * dt;
                    hero.mesh.rotation.y = Math.atan2(hero.dashDir.x, hero.dashDir.z);
                    isMoving = true;
                }
            }
            
            if (!hero.isDashing) {
                if (keys['KeyW'] || keys['ArrowUp']) moveDz -= 1;
                if (keys['KeyS'] || keys['ArrowDown']) moveDz += 1;
                if (keys['KeyA'] || keys['ArrowLeft']) moveDx -= 1;
                if (keys['KeyD'] || keys['ArrowRight']) moveDx += 1;
                if (moveDx !== 0 || moveDz !== 0) {
                    isMoving = true;
                    const len = Math.hypot(moveDx, moveDz);
                    hero.x += (moveDx / len) * hero.speed * dt;
                    hero.z += (moveDz / len) * hero.speed * dt;
                    hero.mesh.rotation.y = Math.atan2(moveDx, moveDz);
                }
            }

            // Коллизии игрока с препятствиями (Obstacle Colliders)
            ecs.query('obstacle', 'transform').forEach(o => {
                const tr = o.c.transform, obs = o.c.obstacle;
                const d = Math.hypot(hero.x - tr.x, hero.z - tr.z);
                const minD = hero.radius + obs.radius;
                if (d < minD && d > 0.0001) {
                    const push = minD - d;
                    hero.x += ((hero.x - tr.x) / d) * push;
                    hero.z += ((hero.z - tr.z) / d) * push;

                    // Если это источник исцеления (Healing Shrine)
                    if (obs.isHealShrine && time - obs.lastHeal > 1.5 && hero.hp < hero.maxHp) {
                        obs.lastHeal = time;
                        hero.hp = Math.min(hero.maxHp, hero.hp + 20);
                        sfx.heal();
                        updateHeroHpUI();
                        spawnDamageText("+20 HP", hero.x, hero.z, false, false, true);
                    }
                }
            });

            // Ограничение границами арены
            const bound = engineConfig.arenaSize - hero.radius - 0.5;
            hero.x = Math.max(-bound, Math.min(bound, hero.x));
            hero.z = Math.max(-bound, Math.min(bound, hero.z));

            // Анимации героя
            if (hero.mesh && hero.mesh.userData && hero.mesh.userData.mixer) {
                hero.mesh.userData.mixer.update(dt);
            }

            if (!hero.mesh.userData || !hero.mesh.userData.hasCustomAnim) {
                const heroBob = isMoving ? Math.sin(time * 14) * 0.04 : Math.sin(time * 3) * 0.015;
                hero.recoil = hero.recoil ? Math.max(0, hero.recoil - dt * 3.5) : 0;
                hero.mesh.position.set(hero.x, Math.abs(heroBob), hero.z);
                
                if (isMoving && !hero.isDashing) {
                    hero.mesh.rotation.z = Math.sin(time * 14) * 0.035;
                    hero.mesh.rotation.x = -0.06;
                } else if (!hero.isDashing) {
                    hero.mesh.rotation.z = 0;
                    hero.mesh.rotation.x = 0;
                }
                
                if (hero.recoil > 0) {
                    hero.mesh.position.y += hero.recoil * 0.2;
                    hero.mesh.rotation.x += hero.recoil * 0.4;
                }
            } else {
                hero.mesh.position.set(hero.x, 0, hero.z);
            }

            // Автоприцеливание и стрельба по ближайшему врагу
            let closest = null, minDist = Infinity;
            ecs.query('enemy', 'transform').forEach(e => {
                const tr = e.c.transform;
                const dist = Math.hypot(tr.x - hero.x, tr.z - hero.z);
                if (dist < minDist) { minDist = dist; closest = tr; }
            });

            const currentWpn = Weapons[currentWeaponKey];
            const maxRange = currentWpn.range || hero.range;
            if (closest && minDist <= maxRange) {
                hero.mesh.rotation.y = Math.atan2(closest.x - hero.x, closest.z - hero.z);
                const effectiveCd = hero.attackCd * (currentWpn.cd / 0.5);
                if (time - hero.lastAttack > effectiveCd) {
                    shootProjectiles(closest);
                    hero.lastAttack = time;
                }
            }

            ecs.update(dt, time);
        }

        function update() {
            const dt = Math.min(clock.getDelta(), 0.1);
            const time = clock.getElapsedTime();

            frameCount++;
            if (time - lastFpsUpdate > 0.5) { 
                document.getElementById('hud-fps').innerText = Math.round(frameCount / (time - lastFpsUpdate)); 
                frameCount = 0; 
                lastFpsUpdate = time; 
            }

            if (currentMode === AppMode.MENU) {
                camera.position.set(Math.sin(time * 0.2) * 35, 25, Math.cos(time * 0.2) * 35); 
                camera.lookAt(0, 0, 0); 
                return;
            }

            document.getElementById('cd-dash').innerText = hero.dashCd - (time - hero.lastDash) <= 0 ? 'ГОТОВ' : Math.max(0, hero.dashCd - (time - hero.lastDash)).toFixed(1) + 'с';
            document.getElementById('cd-nova').innerText = hero.novaCd - (time - hero.lastNova) <= 0 ? 'ГОТОВ' : Math.max(0, hero.novaCd - (time - hero.lastNova)).toFixed(1) + 'с';

            if (!gameState.paused && !gameState.gameOver) {
                updateSimulation(dt, time);
            }

            camera.position.lerp(new THREE.Vector3(hero.x + engineConfig.cameraOffset.x, engineConfig.cameraOffset.y, hero.z + engineConfig.cameraOffset.z), 0.1);
            camera.lookAt(hero.x, 0, hero.z);

            // Если выделен объект в инспекторе — синхронизируем рамку выделения
            if (selectedEntity && selectedEntity.has('mesh') && selectionBox.visible) {
                selectionBox.setFromObject(selectedEntity.c.mesh.obj);
            }
        }

        /* ==============================================================
           13. СИСТЕМЫ ECS ДВИЖКА
           ============================================================== */
        // 1. Физика частиц
        ecs.addSystem((world, dt, time) => {
            world.query('lifetime').forEach(e => {
                e.c.lifetime.time -= dt;
                if (e.c.lifetime.time <= 0) e.dead = true;
            });

            world.query('particle', 'transform', 'velocity').forEach(e => {
                e.c.velocity.vy -= 9.8 * dt;
                e.c.transform.x += e.c.velocity.vx * dt;
                e.c.transform.y = Math.max(0.06, e.c.transform.y + e.c.velocity.vy * dt);
                e.c.transform.z += e.c.velocity.vz * dt;
            });
        });

        // 2. Драгоценные камни опыта
        ecs.addSystem((world, dt, time) => {
            world.query('gem', 'transform', 'mesh').forEach(e => {
                const tr = e.c.transform, d = Math.hypot(hero.x - tr.x, hero.z - tr.z);
                e.c.mesh.obj.rotation.y += dt * 2.5;
                if (d < 5.0) { tr.x += ((hero.x - tr.x) / d) * 14 * dt; tr.z += ((hero.z - tr.z) / d) * 14 * dt; }
                if (d < hero.radius + 0.4) { sfx.gem(); addXp(e.c.gem.val); e.dead = true; }
            });
        });

        // 3. ИИ врагов, коллизии с игроком, препятствиями и другими мобами
        ecs.addSystem((world, dt, time) => {
            if (gameState.paused || gameState.gameOver) return;
            const bound = engineConfig.arenaSize - hero.radius - 0.5;
            const enemies = world.query('enemy', 'transform', 'mesh', 'ui');
            const obstacles = world.query('obstacle', 'transform');
            
            for (let i = 0; i < enemies.length; i++) {
                const e = enemies[i], en = e.c.enemy, tr = e.c.transform;
                
                if (en.frozenTimer > 0) {
                    en.frozenTimer -= dt;
                    if (en.frozenTimer <= 0) {
                        e.c.mesh.obj.traverse(child => {
                            if (child.isMesh && child._sharedMat && child._needsMatDispose) {
                                child.material.dispose();
                                child.material = child._sharedMat; child._needsMatDispose = false;
                            }
                        });
                    }
                    continue;
                }

                const distHero = Math.hypot(hero.x - tr.x, hero.z - tr.z);
                const angle = Math.atan2(hero.z - tr.z, hero.x - tr.x);
                
                if (en.isShooter && distHero < 14) {
                    if (distHero < 8) { tr.x -= Math.cos(angle) * (en.spd * 0.8) * dt; tr.z -= Math.sin(angle) * (en.spd * 0.8) * dt; }
                    if (time - en.lastShot > 2.2) {
                        en.lastShot = time;
                        const em = new THREE.Mesh(enemyProjGeo, enemyProjMat);
                        em.position.set(tr.x, 1.1, tr.z); em.castShadow = true; scene.add(em);
                        ecs.create()
                           .add('transform', {x: tr.x, y: 1.1, z: tr.z})
                           .add('velocity', {vx: Math.cos(angle) * 16, vy: 0, vz: Math.sin(angle) * 16})
                           .add('projectile', {dmg: en.dmg, isHero: false, rotSpeed: (Math.random()-0.5)*12, hits: new Set()})
                           .add('lifetime', {time: 2.5})
                           .add('mesh', {obj: em});
                    }
                } else { 
                    tr.x += Math.cos(angle) * en.spd * dt; 
                    tr.z += Math.sin(angle) * en.spd * dt; 
                }
                tr.rotY = -angle + Math.PI / 2;

                // Коллизии мобов с препятствиями (Walls, Barrels, Pillars)
                for (let o of obstacles) {
                    const oTr = o.c.transform, obs = o.c.obstacle;
                    const d = Math.hypot(tr.x - oTr.x, tr.z - oTr.z);
                    const minD = en.r + obs.radius;
                    if (d < minD && d > 0.001) {
                        const push = minD - d;
                        tr.x += ((tr.x - oTr.x) / d) * push;
                        tr.z += ((tr.z - oTr.z) / d) * push;
                    }
                }

                // Взаимное расталкивание врагов (Bumping)
                for (let j = i + 1; j < enemies.length; j++) {
                    const e2 = enemies[j], en2 = e2.c.enemy, tr2 = e2.c.transform;
                    const dX = tr2.x - tr.x, dZ = tr2.z - tr.z, d = Math.hypot(dX, dZ), minDist = en.r + en2.r;
                    if (d < minDist && d > 0.001) { 
                        const push = ((minDist - d) / 2) * 1.2; 
                        tr.x -= (dX / d) * push; tr.z -= (dZ / d) * push; 
                        tr2.x += (dX / d) * push; tr2.z += (dZ / d) * push; 
                    }
                }

                tr.x = Math.max(-bound, Math.min(bound, tr.x)); 
                tr.z = Math.max(-bound, Math.min(bound, tr.z));
                
                const hasMixer = e.c.mesh.obj && e.c.mesh.obj.userData && e.c.mesh.obj.userData.hasCustomAnim;
                if (!hasMixer) {
                    const walkCycle = Math.sin(time * (en.isBoss ? 5 : 8) + en.id);
                    tr.y = Math.abs(walkCycle) * (en.isBoss ? 0.12 : 0.06);
                    tr.rotZ = walkCycle * 0.06;
                } else {
                    tr.y = 0; tr.rotZ = 0;
                }

                // Урон герою
                if (distHero < en.r + hero.radius && hero.iFrames <= 0 && !engineConfig.godMode) {
                    hero.hp -= en.dmg; 
                    hero.iFrames = 0.45; 
                    sfx.hit();
                    const rEl = document.getElementById('ui-root'); 
                    rEl.classList.remove('screen-flash'); 
                    void rEl.offsetWidth; 
                    rEl.classList.add('screen-flash');
                    updateHeroHpUI(); 
                    spawnDamageText(en.dmg, hero.x, hero.z, true, false);
                }
            }
        });

        // 4. Снаряды, пробивание, разрушение препятствий и AoE взрывы
        ecs.addSystem((world, dt, time) => {
            if (gameState.paused || gameState.gameOver) return;
            const enemies = world.query('enemy', 'transform', 'ui');
            const obstacles = world.query('obstacle', 'transform');
            
            world.query('projectile', 'transform', 'velocity').forEach(p => {
                const tr = p.c.transform, vel = p.c.velocity, proj = p.c.projectile;
                tr.x += vel.vx * dt; 
                tr.z += vel.vz * dt;
                if (proj.rotSpeed) { 
                    tr.rotX = (tr.rotX||0) + proj.rotSpeed * dt; 
                    tr.rotY = (tr.rotY||0) + proj.rotSpeed * dt; 
                }
                
                if (Math.abs(tr.x) > engineConfig.arenaSize || Math.abs(tr.z) > engineConfig.arenaSize) { 
                    p.dead = true; 
                    return; 
                }

                // Попадание в разрушаемые объекты (бочки, ящики, стены)
                for (let o of obstacles) {
                    const oTr = o.c.transform, obs = o.c.obstacle;
                    if (Math.hypot(tr.x - oTr.x, tr.z - oTr.z) < obs.radius + 0.2) {
                        if (obs.isDestructible) {
                            obs.hp -= proj.dmg;
                            sfx.hit();
                            spawnImpactParticles(tr.x, 0.8, tr.z, 0xef4444, 5);
                            if (obs.hp <= 0 && !o.dead) {
                                o.dead = true;
                                if (obs.isExplosive) {
                                    explodeBarrel(oTr.x, oTr.z);
                                } else {
                                    // Ящик с припасами дает XP / лечит
                                    spawnXpGem(oTr.x, oTr.z, 15);
                                    sfx.gem();
                                }
                                updateHierarchyUI();
                            }
                        }
                        if (proj.isExplosive) {
                            explodeBarrel(tr.x, tr.z, proj.aoeRadius, proj.dmg);
                        }
                        p.dead = true;
                        return;
                    }
                }

                if (proj.isHero) {
                    for (let e of enemies) {
                        if (proj.hits.has(e.id) || p.dead) continue;
                        const en = e.c.enemy, eTr = e.c.transform;
                        if (Math.hypot(tr.x - eTr.x, tr.z - eTr.z) < en.r + 0.3) {
                            proj.hits.add(e.id); 
                            en.hp -= proj.dmg; 
                            sfx.hit();
                            spawnImpactParticles(tr.x, 0.8, tr.z, proj.isCrit ? 0xf59e0b : 0xfacc15, 6);
                            spawnDamageText(proj.dmg, eTr.x, eTr.z, false, proj.isCrit);
                            e.c.ui.fill.style.width = `${Math.max(0, (en.hp / en.maxHp) * 100)}%`;
                            
                            if (en.hp <= 0) {
                                e.dead = true; 
                                spawnXpGem(eTr.x, eTr.z, en.xpVal);
                                gameState.score += en.scoreVal; 
                                gameState.enemiesKilled++;
                                document.getElementById('hud-enemies').innerText = world.query('enemy').length - 1;
                            }

                            if (proj.isExplosive) {
                                explodeBarrel(tr.x, tr.z, proj.aoeRadius, proj.dmg);
                                p.dead = true;
                                break;
                            }

                            if (proj.pierceLeft > 0) proj.pierceLeft--;
                            else { p.dead = true; break; }
                        }
                    }
                } else {
                    if (Math.hypot(tr.x - hero.x, tr.z - hero.z) < hero.radius + 0.25) {
                        if (hero.iFrames <= 0 && !engineConfig.godMode) {
                            hero.hp -= proj.dmg; 
                            hero.iFrames = 0.45; 
                            sfx.hit();
                            const rEl = document.getElementById('ui-root'); 
                            rEl.classList.remove('screen-flash'); 
                            void rEl.offsetWidth; 
                            rEl.classList.add('screen-flash');
                            updateHeroHpUI(); 
                            spawnDamageText(proj.dmg, hero.x, hero.z, true, false);
                        }
                        p.dead = true;
                    }
                }
            });
        });

        // 5. Рендер, анимации и UI проекция на экран
        ecs.addSystem((world, dt, time) => {
            world.query('mesh').forEach(e => {
                if (e.c.mesh.obj && e.c.mesh.obj.userData && e.c.mesh.obj.userData.mixer) {
                    e.c.mesh.obj.userData.mixer.update(dt);
                }
            });

            world.query('transform').forEach(e => {
                const tr = e.c.transform;
                if (e.has('mesh')) {
                    const m = e.c.mesh.obj;
                    m.position.set(tr.x, tr.y, tr.z);
                    if (tr.rotX !== undefined) m.rotation.x = tr.rotX;
                    if (tr.rotY !== undefined) m.rotation.y = tr.rotY;
                    if (tr.rotZ !== undefined) m.rotation.z = tr.rotZ;
                    if (tr.scale) m.scale.set(tr.scale.x, tr.scale.y, tr.scale.z);
                }
                if (e.has('ui') || e.has('floatingText')) {
                    projVec.set(tr.x, tr.y + (e.has('enemy') ? e.c.enemy.height + 0.4 : 0), tr.z).project(camera);
                    const el = e.has('ui') ? e.c.ui.bar : e.c.floatingText.el;
                    if (projVec.z < 1) {
                        el.style.display = 'block';
                        el.style.left = `${(projVec.x * 0.5 + 0.5) * window.innerWidth}px`;
                        el.style.top = `${(projVec.y * -0.5 + 0.5) * window.innerHeight}px`;
                        if (e.has('floatingText')) el.style.opacity = Math.max(0, e.c.lifetime.time);
                    } else el.style.display = 'none';
                }
                if (e.has('floatingText')) { tr.y += dt * 1.8; }
            });
        });

        function animate() { 
            requestAnimationFrame(animate); 
            update(); 
            renderer.render(scene, camera); 
        }

        function resetGame() {
            ecs.clear();
            document.getElementById('floating-ui-container').innerHTML = ''; // ПРИНУДИТЕЛЬНАЯ ОЧИСТКА DOM
            hero.x = hero.z = 0; 
            hero.maxHp = hero.hp = 100; 
            hero.mesh.position.set(0, 0, 0); 
            hero.isDashing = false;
            gameState.wave = gameState.level = 1; 
            gameState.score = gameState.xp = gameState.enemiesKilled = 0; 
            gameState.xpNeeded = 25;
            gameState.waveTimer = gameState.waveTime; 
            gameState.gameOver = gameState.paused = false;

            document.getElementById('hud-enemies').innerText = 0; 
            document.getElementById('xp-bar').style.width = '0%';
            document.getElementById('game-over-screen').classList.add('hidden'); 
            document.getElementById('levelup-modal').classList.add('hidden');
            
            // Спавним стандартный набор укрытий и бочек
            document.getElementById('btn-generate-arena').click();
            updateHeroHpUI(); 
            syncEngineInputs();
        }

        document.getElementById('btn-restart-death').onclick = resetGame;
        syncEngineInputs(); 
        updateHeroHpUI(); 
        setWeapon('rifle');
        animate();
    </script>
</body>
