        function updateAssetUI() {
            const keys = ['hero', 'projectile', 'swarmer', 'shooter', 'brute', 'boss'];
            let cachedCount = 0;
            keys.forEach(key => {
                const badge = document.getElementById(`badge-model-${key}`);
                if (!badge) return;
                if (assetManager.has(key)) {
                    cachedCount++;
                    const stats = assetManager.getStats(key);
                    const asset = assetManager.cache.get(key);
                    const animCount = (asset && asset.animations) ? asset.animations.length : 0;
                    const animText = animCount > 0 ? `🎬 ${animCount}` : '🚶 Базовая';
                    const polyText = stats ? `${(stats.triangles/1000).toFixed(1)}k △` : 'OK';
                    badge.innerText = `✓ ${polyText} [${animText}]`;
                    badge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-sky-950 text-sky-300 border border-sky-700/60 font-mono font-bold';
                } else {
                    badge.innerText = 'Дефолт';
