            const hornGeo = new THREE.ConeGeometry(0.18 * s, 0.9 * s, 6);
            const leftHorn = new THREE.Mesh(hornGeo, trollMaterials.stone);
            leftHorn.position.set(-0.6 * s, 2.55 * s, 0.25 * s);
            leftHorn.rotation.z = Math.PI / 3;
            leftHorn.castShadow = true;
            root.add(leftHorn);

            const rightHorn = leftHorn.clone();
            rightHorn.position.x = 0.6 * s;
            rightHorn.rotation.z = -Math.PI / 3;
            root.add(rightHorn);

            return root;
        }

        const defaultEnemyTemplates = {};
        function getEnemyTemplate(typeKey) {
            if (assetManager.has(typeKey)) return assetManager.instantiate(typeKey);
            if (!defaultEnemyTemplates[typeKey]) {
                let model;
                if (typeKey === 'swarmer') model = createTrollWithClub(0.75, false);
                else if (typeKey === 'brute') model = createTrollWithClub(1.35, true);
                else if (typeKey === 'shooter') model = createTrollWithSlingshot(0.95);
                else if (typeKey === 'boss') model = createGiantBossTroll(1.75);
                else model = createTrollWithClub(1.0, false);
                defaultEnemyTemplates[typeKey] = model;
            }
            return defaultEnemyTemplates[typeKey].clone(true);
        }

        /* ==============================================================
           6. ECS (ENTITY-COMPONENT-SYSTEM) И ФАБРИКИ
           ============================================================== */
        class Entity {
            constructor(id) { this.id = id; this.c = {}; this.dead = false; }
            add(name, data) { this.c[name] = data; return this; }
            has(name) { return this.c[name] !== undefined; }
        }

        class ECS {
            constructor() { this.entities = []; this.systems = []; this.nextId = 1; }
            create() { const e = new Entity(this.nextId++); this.entities.push(e); return e; }
            addSystem(sys) { this.systems.push(sys); }
            query(...comps) { return this.entities.filter(e => !e.dead && comps.every(c => e.has(c))); }
            update(dt, time) {
                this.systems.forEach(s => s(this, dt, time));
                this.entities = this.entities.filter(e => {
                    if (e.dead) {
                        if (e.has('mesh') && e.c.mesh.obj) disposeObject(e.c.mesh.obj);
                        if (e.has('ui') && e.c.ui.bar) e.c.ui.bar.remove();
                        if (e.has('floatingText') && e.c.floatingText.el) e.c.floatingText.el.remove();
                    }
                    return !e.dead;
                });
            }
            clear() {
                this.entities.forEach(e => e.dead = true);
                this.update(0, 0);
            }
        }
        
        const ecs = new ECS();
        let nextEntityId = 1;

        // Вспомогательные эффекты частиц и драгоценных камней
        function spawnImpactParticles(x, y, z, colorHex, count = 8) {
            if (!particleMats[colorHex]) particleMats[colorHex] = new THREE.MeshBasicMaterial({ color: colorHex });
            for (let i = 0; i < count; i++) {
                const m = new THREE.Mesh(particleGeo, particleMats[colorHex]);
                m.position.set(x, y, z);
                scene.add(m);
                const angle = Math.random() * Math.PI * 2, spd = 2 + Math.random() * 5;
                ecs.create()
                   .add('transform', {x, y, z})
                   .add('velocity', {vx: Math.cos(angle) * spd, vy: 2 + Math.random() * 4, vz: Math.sin(angle) * spd})
                   .add('lifetime', {time: 0.4})
                   .add('particle', {})
                   .add('mesh', {obj: m});
            }
        }

        function spawnXpGem(x, z, val) {
            const isBoss = val > 25;
            const m = new THREE.Mesh(gemGeo, isBoss ? gemBossMat : gemMat);
            if (isBoss) m.scale.setScalar(1.5);
            m.position.set(x, 0.35, z);
            scene.add(m);
            ecs.create().add('transform', {x, y: 0.35, z}).add('gem', {val}).add('mesh', {obj: m});
        }

        // ==============================================================
        // ФАБРИКА СТАТИЧЕСКИХ И РАЗРУШАЕМЫХ ОБЪЕКТОВ АРЕНЫ
        // ==============================================================
        const PropMaterials = {
            wall: new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.6 }),
            pillar: new THREE.MeshStandardMaterial({ color: 0x64748b, roughness: 0.8 }),
            barrel: new THREE.MeshStandardMaterial({ color: 0xe11d48, roughness: 0.4, metalness: 0.2 }),
            crate: new THREE.MeshStandardMaterial({ color: 0x92400e, roughness: 0.8 }),
            shrine: new THREE.MeshStandardMaterial({ color: 0x10b981, roughness: 0.3, emissive: 0x065f46 })
        };

        function spawnProp(type, x, z, customScale = {x: 1, y: 1, z: 1}, customColor = null, customHp = null) {
            let mesh, colliderRadius = 1.0, isDestructible = false, hp = 100, isExplosive = false, isHealShrine = false;
            
            if (type === 'wall') {
                mesh = new THREE.Mesh(new THREE.BoxGeometry(2, 2.5, 2), PropMaterials.wall.clone());
                mesh.position.set(x, 1.25, z);
                colliderRadius = 1.2;
            } else if (type === 'pillar') {
                mesh = new THREE.Mesh(new THREE.CylinderGeometry(0.8, 0.9, 3.5, 12), PropMaterials.pillar.clone());
                mesh.position.set(x, 1.75, z);
                colliderRadius = 0.9;
            } else if (type === 'barrel') {
                mesh = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.6, 1.4, 10), PropMaterials.barrel.clone());
                mesh.position.set(x, 0.7, z);
                colliderRadius = 0.7;
                isDestructible = true;
                hp = customHp !== null ? customHp : 40;
                isExplosive = true;
            } else if (type === 'crate') {
                mesh = new THREE.Mesh(new THREE.BoxGeometry(1.2, 1.2, 1.2), PropMaterials.crate.clone());
                mesh.position.set(x, 0.6, z);
                colliderRadius = 0.75;
                isDestructible = true;
                hp = customHp !== null ? customHp : 30;
            } else if (type === 'shrine') {
                mesh = new THREE.Mesh(new THREE.OctahedronGeometry(0.9, 1), PropMaterials.shrine.clone());
                mesh.position.set(x, 1.1, z);
                colliderRadius = 1.0;
                isHealShrine = true;
            } else {
                mesh = new THREE.Mesh(new THREE.BoxGeometry(1, 1, 1), PropMaterials.wall.clone());
                mesh.position.set(x, 0.5, z);
            }

            if (customColor && mesh.material) mesh.material.color.set(customColor);
            mesh.scale.set(customScale.x || 1, customScale.y || 1, customScale.z || 1);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            scene.add(mesh);

            const entity = ecs.create()
               .add('transform', { x, y: mesh.position.y, z, rotX: 0, rotY: 0, rotZ: 0, scale: { ...customScale } })
               .add('obstacle', { radius: colliderRadius * Math.max(customScale.x, customScale.z), type, isDestructible, hp, maxHp: hp, isExplosive, isHealShrine, lastHeal: 0 })
               .add('mesh', { obj: mesh });

            mesh.userData.entityId = entity.id;
            updateHierarchyUI();
            return entity;
        }

        // Взрыв бочки (AoE цепная реакция)
        function explodeBarrel(x, z, radius = 5.0, dmg = 85) {
            sfx.explosion();
            spawnImpactParticles(x, 0.8, z, 0xf97316, 35);
            spawnImpactParticles(x, 1.2, z, 0xef4444, 25);

            // Урон всем врагам в радиусе взрыва
            ecs.query('enemy', 'transform', 'ui').forEach(e => {
                const tr = e.c.transform, en = e.c.enemy;
                const d = Math.hypot(tr.x - x, tr.z - z);
                if (d <= radius) {
                    const falloff = 1 - (d / radius) * 0.5;
                    const finalDmg = Math.round(dmg * falloff);
                    en.hp -= finalDmg;
                    spawnDamageText(finalDmg, tr.x, tr.z, false, true);
                    e.c.ui.fill.style.width = `${Math.max(0, (en.hp / en.maxHp) * 100)}%`;
                    if (en.hp <= 0) {
                        e.dead = true;
                        spawnXpGem(tr.x, tr.z, en.xpVal * 1.5);
                        gameState.score += en.scoreVal;
                        gameState.enemiesKilled++;
                    }
                }
            });

            // Урон другим взрывающимся бочкам (цепная детонация)
            ecs.query('obstacle', 'transform').forEach(o => {
                const obs = o.c.obstacle, tr = o.c.transform;
                if (obs.isDestructible && obs.hp > 0) {
                    const d = Math.hypot(tr.x - x, tr.z - z);
                    if (d <= radius && d > 0.1) {
                        obs.hp -= dmg;
                        if (obs.hp <= 0 && !o.dead) {
                            o.dead = true;
                            setTimeout(() => explodeBarrel(tr.x, tr.z), 60);
                        }
                    }
                }
            });

            // Урон игроку, если он слишком близко
            const dHero = Math.hypot(hero.x - x, hero.z - z);
            if (dHero <= radius && hero.iFrames <= 0 && !engineConfig.godMode) {
                const hDmg = Math.round(dmg * 0.35);
                hero.hp -= hDmg;
                hero.iFrames = 0.4;
                sfx.hit();
                updateHeroHpUI();
                spawnDamageText(hDmg, hero.x, hero.z, true, false);
            }
        }

        // Спавн врагов
        const uiContainer = document.getElementById('floating-ui-container');
        function spawnEnemy(typeKey, customX = null, customZ = null) {
            const t = enemyTypes[typeKey];
            let ex = customX, ez = customZ;
            const dist = engineConfig.arenaSize - 1.5;

            if (ex === null || ez === null) {
                const side = Math.floor(Math.random() * 4);
                if (side === 0) { ex = (Math.random() * 2 - 1) * dist; ez = -dist; }
                else if (side === 1) { ex = (Math.random() * 2 - 1) * dist; ez = dist; }
                else if (side === 2) { ex = -dist; ez = (Math.random() * 2 - 1) * dist; }
                else { ex = dist; ez = (Math.random() * 2 - 1) * dist; }
            }

            const mesh = getEnemyTemplate(typeKey);
            scene.add(mesh);

            const hpEl = document.createElement('div');
            hpEl.className = 'enemy-hp-bar' + (t.isBoss ? ' enemy-boss-bar' : '');
            const hpFill = document.createElement('div');
            hpFill.className = 'enemy-hp-fill' + (t.isBoss ? ' enemy-boss-fill' : '');
            hpEl.appendChild(hpFill);
            uiContainer.appendChild(hpEl);

            const hpScaled = t.hp * (1 + (gameState.wave - 1) * 0.25) * engineConfig.enemyHpMult;
            
            const e = ecs.create()
               .add('transform', {x: ex, y: 0, z: ez, rotY: 0, rotZ: 0})
               .add('enemy', {id: nextEntityId++, type: typeKey, hp: hpScaled, maxHp: hpScaled, dmg: t.dmg * (1 + (gameState.wave - 1) * 0.15), spd: t.spd * engineConfig.enemySpdMult, r: t.r, height: t.height, isShooter: !!t.isShooter, isBoss: !!t.isBoss, lastShot: 0, frozenTimer: 0, xpVal: t.xp, scoreVal: t.score})
               .add('mesh', {obj: mesh})
               .add('ui', {bar: hpEl, fill: hpFill});
               
            mesh.userData.entityId = e.id;
            document.getElementById('hud-enemies').innerText = ecs.query('enemy').length;
        }

        let lastSpawnTime = 0, bossSpawnedThisWave = false;
        function updateWaveSystem(dt, time) {
            if (gameState.waveTimer > 0) gameState.waveTimer -= dt;
            else {
                gameState.wave++; 
                gameState.waveTimer = gameState.waveTime; 
                bossSpawnedThisWave = false;
                syncEngineInputs(); 
                hero.hp = Math.min(hero.maxHp, hero.hp + hero.maxHp * 0.3);
                updateHeroHpUI(); 
                spawnDamageText("ВОЛНА " + gameState.wave, hero.x, hero.z, false, true);
            }
            if (!engineConfig.autoSpawn) return;
            if (gameState.wave % 3 === 0 && !bossSpawnedThisWave && gameState.waveTimer <= gameState.waveTime * 0.7) { 
                spawnEnemy('boss'); 
                bossSpawnedThisWave = true; 
            }
            if (time - lastSpawnTime > engineConfig.spawnInterval) {
                lastSpawnTime = time;
                let pick = 'swarmer';
                const roll = Math.random();
                if (gameState.wave >= 2 && roll < 0.35) pick = 'shooter';
                else if (gameState.wave >= 3 && roll > 0.7) pick = 'brute';
                spawnEnemy(pick);
            }
        }

        /* ==============================================================
           7. УПРАВЛЕНИЕ, БОЙ И СТРЕЛЬБА
           ============================================================== */
        const keys = {};
        window.addEventListener('keydown', e => {
            if (e.target.tagName === 'INPUT') return;
            keys[e.code] = true;
            if (currentMode === AppMode.MENU) return;
            if (e.code === 'Space') tryDash();
            if (e.code === 'KeyE') tryNova();
            if (e.code === 'Digit1') setWeapon('rifle');
            if (e.code === 'Digit2') setWeapon('shotgun');
            if (e.code === 'Digit3') setWeapon('plasma');
            if (e.code === 'Digit4') setWeapon('grenade');
        });
        window.addEventListener('keyup', e => keys[e.code] = false);
        window.addEventListener('blur', () => {
            for (let key in keys) {
                keys[key] = false;
            }
            if (hero) hero.isDashing = false;
        });

        function setWeapon(key) {
            if (!Weapons[key]) return;
            currentWeaponKey = key;
            const wpn = Weapons[key];
            document.getElementById('hud-weapon-name').innerText = wpn.name;
            document.querySelectorAll('.weapon-btn').forEach(b => {
                b.classList.toggle('tool-btn-active', b.dataset.wpn === key);
            });
        }

        function tryDash() {
            const time = clock.getElapsedTime();
            if (time - hero.lastDash < hero.dashCd || gameState.paused || gameState.gameOver || hero.isDashing) return;
            hero.lastDash = time;
            hero.isDashing = true;
            hero.iFrames = hero.dashDuration + 0.1;
            sfx.dash();

            let dx = 0, dz = 0;
            if (keys['KeyW'] || keys['ArrowUp']) dz -= 1;
            if (keys['KeyS'] || keys['ArrowDown']) dz += 1;
            if (keys['KeyA'] || keys['ArrowLeft']) dx -= 1;
            if (keys['KeyD'] || keys['ArrowRight']) dx += 1;
            if (dx === 0 && dz === 0) dz = -1;

            const len = Math.hypot(dx, dz);
            hero.dashDir = { x: dx / len, z: dz / len };
            spawnImpactParticles(hero.x, 0.8, hero.z, 0x38bdf8, 14);
        }

        function tryNova() {
            const time = clock.getElapsedTime();
            if (time - hero.lastNova < hero.novaCd || gameState.paused || gameState.gameOver) return;
            hero.lastNova = time;
            sfx.nova();
            spawnImpactParticles(hero.x, 0.4, hero.z, 0x06b6d4, 30);
            ecs.query('enemy', 'transform').forEach(e => {
                const en = e.c.enemy, tr = e.c.transform;
                if (Math.hypot(tr.x - hero.x, tr.z - hero.z) <= 9.0) {
                    en.hp -= hero.damage * 1.5; en.frozenTimer = 3.5;
                    e.c.mesh.obj.traverse(child => {
                        if (child.isMesh && child.material) {
                            if (!child._sharedMat) child._sharedMat = child.material;
                            child.material = child._sharedMat.clone();
                            child.material.color.setHex(0x06b6d4);
                            child._needsMatDispose = true;
                        }
                    });
                    spawnDamageText(hero.damage * 1.5, tr.x, tr.z, false, false);
                }
            });
        }

        function shootProjectiles(target) {
            const wpn = Weapons[currentWeaponKey];
            sfx.shoot(currentWeaponKey);
            const dirX = target.x - hero.x, dirZ = target.z - hero.z;
            const baseAngle = Math.atan2(dirZ, dirX);
            const heroAngle = hero.mesh.rotation.y;
            const localRifleX = 0.18, localRifleZ = 1.25;
            const muzzleX = hero.x + localRifleX * Math.cos(heroAngle) + localRifleZ * Math.sin(heroAngle);
            const muzzleZ = hero.z - localRifleX * Math.sin(heroAngle) + localRifleZ * Math.cos(heroAngle);
            const muzzleY = 1.12;

            spawnImpactParticles(muzzleX, muzzleY, muzzleZ, currentWeaponKey === 'plasma' ? 0x38bdf8 : 0xfde047, 4);
            hero.recoil = 0.14;

            const totalProjectiles = Math.max(1, hero.projectileCount + (wpn.count - 1));
            for (let i = 0; i < totalProjectiles; i++) {
                const spreadAngle = (i - (totalProjectiles - 1) / 2) * (wpn.spread || 0.15);
                const angle = baseAngle + spreadAngle + (Math.random() - 0.5) * 0.04;
                
                let pMesh;
                if (assetManager.has('projectile')) {
                    pMesh = assetManager.instantiate('projectile');
                } else if (currentWeaponKey === 'plasma') {
                    pMesh = new THREE.Mesh(defaultProjGeo, plasmaProjMat);
                } else if (currentWeaponKey === 'grenade') {
                    pMesh = new THREE.Mesh(grenadeProjGeo, grenadeProjMat);
                } else {
                    pMesh = new THREE.Mesh(defaultProjGeo, defaultProjMat);
                }

                pMesh.position.set(muzzleX, muzzleY, muzzleZ);
                scene.add(pMesh);
                const isCrit = Math.random() < hero.critChance;
                const finalDamage = Math.round(hero.damage * wpn.dmgMult * (isCrit ? hero.critMult : 1.0));
                
                ecs.create()
                   .add('transform', {x: muzzleX, y: muzzleY, z: muzzleZ})
                   .add('velocity', {vx: Math.cos(angle) * (wpn.speed || hero.projSpeed), vy: 0, vz: Math.sin(angle) * (wpn.speed || hero.projSpeed)})
                   .add('projectile', {
                       dmg: finalDamage, 
                       isCrit, 
                       pierceLeft: hero.piercing + wpn.pierce, 
                       hits: new Set(), 
                       isHero: true,
                       isExplosive: !!wpn.isExplosive,
                       aoeRadius: wpn.aoeRadius || 4.5
                   })
                   .add('lifetime', {time: (wpn.range || hero.range) / (wpn.speed || hero.projSpeed)})
                   .add('mesh', {obj: pMesh});
            }
        }

        /* ==============================================================
           8. АПГРЕЙДЫ И UI ТЕКСТ
           ============================================================== */
        const availableUpgrades = [
            { title: 'Доп. Снаряд', desc: '+1 Снаряд ко всем атакам', icon: '🏹', apply: () => { hero.projectileCount += 1; syncEngineInputs(); } },
            { title: 'Заточка лезвий', desc: '+35% Урона', icon: '⚔️', apply: () => { hero.damage = Math.round(hero.damage * 1.35); syncEngineInputs(); } },
            { title: 'Глаз Сокола', desc: '+15% Крит, +45% крит урон', icon: '🎯', apply: () => { hero.critChance = Math.min(1.0, hero.critChance + 0.15); hero.critMult += 0.45; syncEngineInputs(); } },
            { title: 'Ловкость стрелка', desc: '+25% к Скорости атаки', icon: '⚡', apply: () => { hero.attackCd = Math.max(0.06, hero.attackCd * 0.78); syncEngineInputs(); } },
            { title: 'Бронебойные патроны', desc: '+2 Пробивания препятствий', icon: '🔱', apply: () => { hero.piercing += 2; syncEngineInputs(); } },
            { title: 'Сердце Титана', desc: '+50 Max HP и полное лечение', icon: '💖', apply: () => { hero.maxHp += 50; hero.hp = hero.maxHp; updateHeroHpUI(); } },
            { title: 'Сапоги Ветра', desc: '+20% Скорость бега', icon: '🥾', apply: () => { hero.speed *= 1.2; syncEngineInputs(); } }
        ];

        function addXp(amount) {
            gameState.xp += amount;
            while (gameState.xp >= gameState.xpNeeded) {
                gameState.xp -= gameState.xpNeeded; 
                gameState.level++; 
                gameState.xpNeeded = Math.round(gameState.xpNeeded * 1.45); 
                triggerLevelUp();
            }
            document.getElementById('xp-bar').style.width = `${(gameState.xp / gameState.xpNeeded) * 100}%`;
            document.getElementById('hud-level').innerText = gameState.level;
            document.getElementById('hud-score').innerText = gameState.score;
        }

        function triggerLevelUp() {
            gameState.paused = true; 
            sfx.lvlUp();
            const modal = document.getElementById('levelup-modal');
            const cards = document.getElementById('upgrade-cards');
            cards.innerHTML = '';
            [...availableUpgrades].sort(() => 0.5 - Math.random()).slice(0, 3).forEach(upg => {
                const card = document.createElement('div');
                card.className = 'upgrade-card glass-panel p-6 rounded-2xl cursor-pointer text-center flex flex-col items-center justify-between border-2 border-slate-700/60';
                card.innerHTML = `<div class="text-5xl mb-4">${upg.icon}</div><div class="text-lg font-black text-sky-300 mb-2">${upg.title}</div><div class="text-xs text-slate-300 mb-6">${upg.desc}</div><button class="w-full py-2 bg-sky-500 hover:bg-sky-400 text-slate-950 font-black text-sm rounded-xl transition">ВЫБРАТЬ</button>`;
                card.onclick = () => { upg.apply(); modal.classList.add('hidden'); gameState.paused = false; };
                cards.appendChild(card);
            });
            modal.classList.remove('hidden');
        }

        function spawnDamageText(amount, x, z, isHeroTaking, isCrit = false, isHeal = false) {
            const el = document.createElement('div');
            el.className = 'floating-damage' + (isCrit ? ' damage-crit' : '') + (isHeal ? ' damage-heal' : '');
            if (!isCrit && !isHeal) el.style.color = isHeroTaking ? '#f43f5e' : '#ffffff';
            el.textContent = typeof amount === 'number' ? Math.round(amount) : amount;
            uiContainer.appendChild(el);
            ecs.create()
               .add('transform', {x, y: isHeroTaking ? 2.4 : 1.4, z})
               .add('floatingText', {el, isHp: false})
               .add('lifetime', {time: 0.85});
        }

        function updateHeroHpUI() {
            document.getElementById('hero-hp-fill').style.width = `${Math.max(0, (hero.hp / hero.maxHp) * 100)}%`;
            document.getElementById('hero-hp-text').innerText = `${Math.ceil(hero.hp)} / ${hero.maxHp}`;
            if (hero.hp <= 0 && !gameState.gameOver && !engineConfig.godMode) {
                gameState.gameOver = true;
                document.getElementById('game-over-stats').innerText = `Волна: ${gameState.wave} | Счёт: ${gameState.score} | Убито: ${gameState.enemiesKilled}`;
                document.getElementById('game-over-screen').classList.remove('hidden');
            }
        }

        /* ==============================================================
           9. ИНТЕРАКТИВНЫЙ РЕДАКТОР СЦЕНЫ И РЕЙКАСТИНГ (LEVEL EDITOR)
           ============================================================== */
        let activeTool = 'select'; // 'select', 'wall', 'barrel', 'crate', 'shrine', 'pillar'
        let selectedEntity = null;
        const raycaster = new THREE.Raycaster();
        const mouse = new THREE.Vector2();
        const planeY0 = new THREE.Plane(new THREE.Vector3(0, 1, 0), 0);
        const intersectPoint = new THREE.Vector3();

        document.querySelectorAll('.tool-btn').forEach(btn => {
            btn.onclick = () => {
                document.querySelectorAll('.tool-btn').forEach(b => b.classList.remove('tool-btn-active'));
                btn.classList.add('tool-btn-active');
                activeTool = btn.dataset.tool;
                document.getElementById('editor-mode-badge').innerText = activeTool.toUpperCase();
                placementCursor.visible = (activeTool !== 'select');
            };
        });

        window.addEventListener('mousemove', e => {
            if (currentMode !== AppMode.DEV_EDITOR && activeTool === 'select') return;
            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera(mouse, camera);

            if (raycaster.ray.intersectPlane(planeY0, intersectPoint)) {
                let px = intersectPoint.x;
                let pz = intersectPoint.z;
                if (engineConfig.gridSnap) {
                    px = Math.round(px);
                    pz = Math.round(pz);
                }
                placementCursor.position.set(px, 0.05, pz);
            }
        });

        // Клик на сцене для размещения или выделения
        window.addEventListener('pointerdown', e => {
            if (e.target.closest('#engine-panel') || e.target.closest('#main-menu') || e.target.closest('#settings-modal') || e.target.closest('#levelup-modal')) return;
            if (currentMode !== AppMode.DEV_EDITOR) return;

            mouse.x = (e.clientX / window.innerWidth) * 2 - 1;
            mouse.y = -(e.clientY / window.innerHeight) * 2 + 1;
            raycaster.setFromCamera(mouse, camera);

            if (activeTool === 'select') {
                // Ищем пересечения с мешами на сцене
                const meshes = ecs.query('mesh').map(e => e.c.mesh.obj);
                const intersects = raycaster.intersectObjects(meshes, true);
                if (intersects.length > 0) {
                    let hitMesh = intersects[0].object;
                    while (hitMesh && !hitMesh.userData.entityId && hitMesh.parent) {
                        hitMesh = hitMesh.parent;
                    }
                    if (hitMesh && hitMesh.userData.entityId) {
                        const ent = ecs.entities.find(e => e.id === hitMesh.userData.entityId);
                        if (ent) selectEntity(ent);
                    }
                } else {
                    selectEntity(null);
                }
            } else {
                // Размещение префаба
                if (raycaster.ray.intersectPlane(planeY0, intersectPoint)) {
                    let px = intersectPoint.x;
                    let pz = intersectPoint.z;
                    if (engineConfig.gridSnap) {
                        px = Math.round(px);
                        pz = Math.round(pz);
                    }
                    const ent = spawnProp(activeTool, px, pz);
                    selectEntity(ent);
                }
            }
        });

        function selectEntity(ent) {
            selectedEntity = ent;
            const emptyEl = document.getElementById('inspector-empty');
            const contentEl = document.getElementById('inspector-content');

            if (!ent) {
                emptyEl.classList.remove('hidden');
                contentEl.classList.add('hidden');
                selectionBox.visible = false;
                return;
            }

            emptyEl.classList.add('hidden');
            contentEl.classList.remove('hidden');

            const tr = ent.c.transform;
            const meshObj = ent.c.mesh.obj;
            selectionBox.setFromObject(meshObj);
            selectionBox.visible = true;

            const name = ent.has('obstacle') ? `Префаб [${ent.c.obstacle.type}] #${ent.id}` : (ent.has('enemy') ? `Враг [${ent.c.enemy.type}] #${ent.id}` : `Сущность #${ent.id}`);
            document.getElementById('insp-entity-name').innerText = name;
            document.getElementById('insp-pos-x').value = tr.x.toFixed(1);
            document.getElementById('insp-pos-y').value = tr.y.toFixed(1);
            document.getElementById('insp-pos-z').value = tr.z.toFixed(1);

            const scale = tr.scale || { x: meshObj.scale.x, y: meshObj.scale.y, z: meshObj.scale.z };
            document.getElementById('insp-scale-x').value = scale.x.toFixed(1);
            document.getElementById('insp-scale-y').value = scale.y.toFixed(1);
            document.getElementById('insp-scale-z').value = scale.z.toFixed(1);

            const hpRow = document.getElementById('insp-hp-row');
            if (ent.has('obstacle') && ent.c.obstacle.isDestructible) {
                hpRow.classList.remove('hidden');
                document.getElementById('insp-hp').value = ent.c.obstacle.hp;
